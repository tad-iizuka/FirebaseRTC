<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LiveKit接続(トークンサーバー・WebRTC)に必要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- PTTのマイク取得に必須。取得しないとRoom.localParticipant.setMicrophoneEnabled(true)が失敗する -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 接続中にBluetoothヘッドセット等を使う場合 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- [Phase9] バックグラウンドでも送受話を継続するためのフォアグラウンドサービス化。
         PTTForegroundService(connection/)がroom接続中のみstartForeground()する。
         iOS版のUIBackgroundModes=audioに相当する仕組み -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+ ではフォアグラウンド通知の表示自体に実行時許可が必要 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- [招待リンク/QR] アプリ内QRスキャナー用。deeplink-qr-join-plan.md参照 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PTTApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PTTAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- [招待リンク] admin-dashboardが生成するApp Linkの受け口。
                 android:autoVerify="true" によりインストール時にAndroidが
                 https://fir-rtc-de1f4.web.app/.well-known/assetlinks.json を検証し、
                 検証が通れば同ドメインのリンクをブラウザを介さず直接このActivityへ渡す。
                 deeplink-qr-join-plan.md参照。自動参加はしない(MainActivity側で
                 Room ID/招待コードを入力欄へ反映するだけ)。 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="fir-rtc-de1f4.web.app"
                    android:pathPrefix="/r" />
            </intent-filter>
        </activity>

        <!-- [Phase9] バックグラウンドでの接続維持・送受話継続を担うフォアグラウンドサービス。
             Activityの生存期間に縛られずPTTConnectionManagerを保持する
             (connection/PTTForegroundService.kt参照) -->
        <service
            android:name=".connection.PTTForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
