<?xml version="1.0" encoding="utf-8"?>
<!--
    ログイン状態アイコン(LoginStatusIcon)の未サインイン/写真なし時のプレースホルダー。
    Web版はlucideの`User`アイコン、iOS版はSF Symbolsの`person.fill`を使っており、
    Android側は material-icons-extended への依存を増やさない方針
    (onboarding/PTTOnboardingScreen.ktのコメント参照)のため、単色シルエットの
    vector drawableとして自前定義する。塗り色はComposeのIcon(tint=...)側で
    PTTColors.Mutedを指定し、この定義自体はic_notification_ptt.xmlと同様に
    黒(#FF000000)の輪郭のみを持つ。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z" />
</vector>
