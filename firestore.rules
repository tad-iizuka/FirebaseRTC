rules_version = '2';

// [設計方針]
// token-server/README.md に記載の設計をそのまま強制する:
//   - ルーム作成・参加(招待コード検証)・BAN・通報の書き込みは、すべて
//     token-server が Admin SDK 経由で行う(Admin SDKはこのルールをバイパスする)。
//   - クライアントからの直接書き込みは一切許可しない。
//   - 例外として、自分自身の members/{uid} ドキュメントの読み取りだけは許可する。
//     これはリアルタイムリスナーで「自分がBANされたこと」を即座にUIへ
//     反映するための補助であり、BAN自体の強制力はLiveKit側の即時キックが担う。
//   - [Phase5] チャットメッセージ(messages)は、ルームの「アクティブな」メンバーのみ
//     読み取り可能とする。BANされてstatusが'banned'に変わった瞬間、この条件を
//     満たさなくなり読み取り権限も自動的に失う(ボイスのBAN即時キックと同じ
//     二重の強制力を持たせる設計)。書き込みは引き続きAdmin SDK経由のみ。
//   - [Phase5] adminUsers(管理者権限の台帳)はクライアントに一切公開しない。
//     自分が管理者かどうかもクライアント側には開示せず、token-server側の
//     ミドルウェア(middleware/requireAdmin.js)だけが参照する。付与/剥奪は
//     dev-tools/grant-admin-permission.js でAdmin SDK経由・手動運用する。
//   - [Phase8] 監査ログ(auditLogs)・録音履歴(recordings)もクライアントへの
//     直接公開は行わない。閲覧はそれぞれ GET /admin/audit-logs
//     (audit:read権限)・GET /rooms/:roomId/recordings(メンバーのみ)経由に限定する。
//   - [Phase11] 組織階層(organizations/nodes)もクライアントへの直接公開は
//     行わない。rooms本体と同様、参照は必ずtoken-server経由のAPI
//     (GET /rooms/:roomId/org-context, GET /admin/organizations 等)を通す。
//     rooms/members が持つ「自分自身のドキュメントだけ即時UI反映のため読める」
//     という例外パターンはここでは採用しない。「自分がこのorgId配下の
//     いずれかのroomのメンバーであるか」をrules内で安全に判定する手段が
//     ないため(member一覧をorganizationsドキュメントへ同期する設計は、
//     Guestの一時参加ライフサイクル(招待コード生存中のみ有効)と
//     同期タイミングが噛み合わず不採用)。
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      // ルーム本体(inviteCode含む)はクライアントに一切公開しない。
      // 招待コードの検証は必ず token-server の POST /rooms/:roomId/join を通す。
      allow read, write: if false;

      match /members/{uid} {
        // 自分自身のメンバードキュメントのみ読み取り可(BAN即時反映のUI用)。
        allow read: if request.auth != null && request.auth.uid == uid;
        // role/status の変更(参加・BAN・BAN解除・moderator任命等)はすべて
        // サーバーAPI経由に限定。
        allow write: if false;
      }

      match /messages/{messageId} {
        // [Phase5: テキストチャット]
        // 自分がこのルームの「アクティブな」メンバーである場合のみ履歴を読める。
        // BANされてstatusが'banned'に変わった瞬間、この条件が false になり
        // 読み取り権限も自動的に失う(LiveKit即時キックと同様、二重の強制力を持たせる設計)。
        allow read: if request.auth != null &&
          exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.status == 'active';
        // 書き込みはtoken-server(Admin SDK経由)のみ。クライアントからの直接書き込みは禁止
        // (本文の長さチェック・レート制限をサーバー側で強制するため)。
        allow write: if false;
      }

      match /recordings/{recordingId} {
        // [Phase8] 録音履歴のメタデータ(ファイルパス等)。クライアントへの
        // 直接開示はせず、必ずtoken-server経由(GET /rooms/:roomId/recordings,
        // .../download-url)で取得させる(ダウンロードURL発行権限を
        // owner/moderatorに限定するため)。
        allow read, write: if false;
      }
    }

    match /organizations/{orgId} {
      // [Phase11] 組織階層(Company/Branch/Site、あるいはCommunity/Group)。
      // rooms/members と同じ理由でクライアントへの直接公開は行わない。
      // 加えて、rooms特有の「自分自身のmembersドキュメントだけ即時UI反映のため
      // 読める」という例外パターンもここでは採用しない: 「自分がこのorgId配下の
      // 何らかのroomのメンバーであるか」をrules内で判定する手段がない
      // (member配列をorganizationsドキュメントへ同期する設計は、Guestの
      // 一時参加ライフサイクル(招待コード生存中のみ有効)と同期タイミングが
      // 噛み合わないため不採用)。
      // 団体名・拠点名の表示は token-server 経由の参照API
      // (GET /rooms/:roomId/org-context, GET /admin/organizations 等)に一本化する。
      allow read, write: if false;

      match /nodes/{nodeId} {
        // orgId直下の階層ノード(Branch/Site、あるいはGroup)。
        // 理由は親(organizations)と同じ。
        allow read, write: if false;
      }
    }

    match /reports/{reportId} {
      // 通報の受付・閲覧はサーバー(モデレーター運用)のみ。
      allow read, write: if false;
    }

    match /adminUsers/{uid} {
      // 管理者権限台帳。誰が管理者か、どの権限を持つかはクライアントに一切
      // 開示しない(自分自身のドキュメントであっても読み取り不可。
      // rooms/members とは異なり「即時UI反映」のニーズが無いための判断)。
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      // [Phase8] 監査ログ。GET /admin/audit-logs (audit:read権限) 経由でのみ
      // 閲覧可能。クライアントSDKからの直接読み書きは一切許可しない。
      allow read, write: if false;
    }

    match /badges/{badgeId} {
      // [Phase13] バッジマスタ。団体スコープを持たない全体共通マスタ
      // (brushup-plan.md 6.1 item14で確定)。
      // [実装時の変更点] phase13-badge-schema.md「8.」は当初「全クライアント
      // 読み取り可」としていたが、参加者一覧の「最優先1個のみ表示」判定
      // (badgeGrantsとの突き合わせ・Guest仮想バッジの合成)を3クライアント
      // それぞれで再実装させないため、この判定を含めてサーバー側の参照API
      // (GET /rooms/:roomId/badges 等)に一本化し、直接公開はしない方針へ
      // 変更した(lib/badges.js冒頭コメント参照)。
      allow read, write: if false;
    }

    match /badgeGrants/{grantId} {
      // [Phase13] バッジの付与/剥奪履歴。他人の付与状況を含むため、
      // badgesと同様にクライアントへの直接公開は行わない。
      allow read, write: if false;
    }

    match /config/{configId} {
      // [Phase13] config/badgeDisplay(バッジ表示件数設定)を含む、
      // アプリケーション全体の設定用ドキュメント群。書き込みは
      // Admin SDK経由(GET/PATCH /admin/config/badge-display)のみ。
      allow read, write: if false;
    }

    // 上記以外のコレクション/ドキュメントへのアクセスはデフォルトで拒否。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
